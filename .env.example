# ========================================================
# VAULT Environment Configuration (.env.example)
# NEVER commit .env or real credentials into git!
# ========================================================

# Admin Passkey Hash (Generate using `node scripts/hash-passkey.mjs <passkey>`)
ADMIN_PASSKEY_HASH=

# Session Secret (Cryptographically random 32+ byte string used for JWT signing)
SESSION_SECRET=

# Upstash Redis (For site metadata persistence & rate limiting on Vercel)
# Available via Vercel Marketplace -> Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (For thumbnail image storage on Vercel)
# Automatically populated when you connect Vercel Blob store in project settings
BLOB_READ_WRITE_TOKEN=

# Optional: Local Database URL (Fallback only if using local SQLite for development)
# DATABASE_URL="file:./vault.db"
